# SecureMesh Testbed LLM Configuration

# LLM_PROVIDER can be 'gemini' or 'ollama'
LLM_PROVIDER=gemini

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama Configuration (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Generation Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=256

# Physical Honeypot & Network Configuration
# Keep actual values private in .env and esp8266/secrets.h (both are git-ignored)
WIFI_SSID="YOUR_2.4GHZ_WIFI_SSID"
WIFI_PASSWORD="YOUR_WIFI_PASSWORD"
BACKEND_HOST_IP="192.168.1.100"
BACKEND_URL="http://192.168.1.100:8000/api/logs/"
ESP8266_DEVICE_IP="192.168.1.150"
