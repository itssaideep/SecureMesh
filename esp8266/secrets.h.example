#pragma once

#ifndef SECRETS_H_EXAMPLE
#define SECRETS_H_EXAMPLE

// ==============================================================================
// SecureMesh-SCE: ESP8266 Secrets Template
//
// Instructions:
// 1. Copy this file and rename it to 'secrets.h' in the same directory:
//    cp esp8266/secrets.h.example esp8266/secrets.h
// 2. Fill in your actual 2.4GHz Wi-Fi SSID, Password, and your computer's IP.
// 3. 'secrets.h' is ignored by .gitignore and will never be committed.
// ==============================================================================

// 2.4 GHz Wi-Fi Network Credentials (ESP8266 only supports 2.4 GHz)
#define WIFI_SSID "YOUR_2.4GHZ_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Computer running the FastAPI Backend (Log Ingestion Service)
#define BACKEND_HOST "192.168.1.100"
#define BACKEND_PORT 8000
#define BACKEND_URL "http://192.168.1.100:8000/api/logs/"

#endif // SECRETS_H_EXAMPLE
